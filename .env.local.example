# Copy to .env.local and fill in. Restart the dev server after editing.

# --- Supabase (phase 1: auth + database) ---
# Project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Public anon key (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service-role key (server only - NEVER expose to the browser). REQUIRED: used to
# mint accounts at signup (access-key auth) and to write the snapshot cache.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public base URL of the app (used for absolute links / deploys).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Chain & price APIs (phase 3) ---
# EVM + Solana tokens & DeFi positions via Zerion (one key covers both).
# Free dev keys (begin with `zk_`) at https://dashboard.zerion.io. Without it,
# EVM and Solana are skipped. Pass the key as-is; the app handles Basic auth.
# ZERION_API_KEY=
# Prices for BTC/ZEC + manual holdings (works without a key; demo key raises limits).
# COINGECKO_API_KEY=
# Zcash transparent via Blockchair (works keyless for light use; a key raises limits).
# BLOCKCHAIR_API_KEY=
# Bitcoin uses Blockstream Esplora - no key required.
